{
  "name": "ui-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "uieditor": "./cli/run.mjs"
  },
  "files": [
    "dist-cli",
    "cli/run.mjs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/write-dist-root.mjs && npm run build:cli",
    "build:web": "vue-tsc -b && vite build && node scripts/write-dist-root.mjs",
    "build:cli": "tsup",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "cli": "tsx cli/uieditor.ts",
    "prepack": "npm run build:cli"
  },
  "dependencies": {
    "ag-psd": "^31.0.2",
    "buffer": "^6.0.3",
    "element-plus": "^2.14.3",
    "pinia": "^4.0.2",
    "pixi.js": "^8.19.0",
    "pngjs": "^7.0.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.5",
    "typescript": "5.9",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.9"
  }
}
